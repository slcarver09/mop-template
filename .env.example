# Copy this to .env and fill in your values
# This file shows what variables are needed, but no actual secrets

# API Configuration
VITE_API_URL=http://localhost:5000

# Feature Flags
VITE_ENABLE_LOGGING=false
VITE_ENABLE_WATERMARK=true

# Limits
VITE_MAX_INPUT_LENGTH=255
VITE_MAX_TEXTAREA_LENGTH=5000